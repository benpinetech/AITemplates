/* JDA → Pine Converter — application stylesheet
 *
 * Aesthetic: professional-modern. Clean light theme with indigo
 * accents, slate-tinted neutrals, and generous whitespace. Inspired
 * by Linear / Notion / Stripe Dashboard rather than Material default.
 *
 * Palette (slate + indigo, modeled on tailwindcss):
 *   accent / primary   #6366f1   indigo-500
 *   accent hover       #4f46e5   indigo-600
 *   accent pressed     #4338ca   indigo-700
 *   surface            #ffffff
 *   background         #f8fafc   slate-50
 *   border             #e2e8f0   slate-200
 *   border-strong      #cbd5e1   slate-300
 *   text               #0f172a   slate-900
 *   text-muted         #64748b   slate-500
 *   text-subtle        #94a3b8   slate-400
 *   success / pattern  #10b981   emerald-500
 *   warn / LLM         #f59e0b   amber-500
 *   danger             #ef4444   red-500
 *   legacy chip        #fef3c7 / #92400e   amber-100 / amber-800
 *   pine chip          #e0e7ff / #3730a3   indigo-100 / indigo-800
 */

/* ── window + base text ────────────────────────────────────────────────── */
QMainWindow, QWidget {
    background-color: #f8fafc;
    color: #0f172a;
    font-family: "Inter", "SF Pro Text", "Segoe UI Variable", "Segoe UI",
                 "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
}

/* ── menu bar ── */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 6px 10px;
}
QMenuBar::item {
    padding: 6px 12px;
    border-radius: 7px;
    background: transparent;
    color: #334155;
}
QMenuBar::item:selected {
    background: #eef2ff;
    color: #4338ca;
}

QMenu {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 16px;
    border-radius: 6px;
    color: #1e293b;
}
QMenu::item:selected {
    background: #eef2ff;
    color: #4338ca;
}
QMenu::separator {
    height: 1px;
    background: #f1f5f9;
    margin: 4px 8px;
}

/* ── toolbar ──────────────────────────────────────────────────────────── */
QToolBar#mainToolbar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 10px 14px;
    spacing: 8px;
}
QToolBar#mainToolbar QToolButton {
    padding: 8px 14px;
    border-radius: 8px;
    background: transparent;
    color: #1e293b;
    font-weight: 500;
}
QToolBar#mainToolbar QToolButton:hover {
    background: #eef2ff;
    color: #4338ca;
}
QToolBar#mainToolbar QToolButton:pressed {
    background: #e0e7ff;
}
QToolBar#mainToolbar QToolButton:disabled {
    color: #94a3b8;
}
QToolBar#mainToolbar::separator {
    background: #e2e8f0;
    width: 1px;
    margin: 8px 6px;
}
QToolBar QLabel#toolbarLabel {
    color: #64748b;
    padding: 0 4px;
    font-weight: 500;
}

QComboBox {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 6px 12px;
    min-height: 24px;
    min-width: 240px;
    selection-background-color: #6366f1;
    color: #1e293b;
}
QComboBox:hover {
    border-color: #cbd5e1;
}
QComboBox:focus {
    border-color: #6366f1;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

/* ── central panes ────────────────────────────────────────────────────── */
QSplitter#mainSplitter {
    background: #f8fafc;
}
QSplitter::handle {
    background: #e2e8f0;
}
QSplitter::handle:hover {
    background: #cbd5e1;
}

QLabel#paneCaption {
    background: #ffffff;
    color: #64748b;
    border-bottom: 1px solid #e2e8f0;
    padding: 10px 16px;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
}

QPlainTextEdit {
    background: #ffffff;
    border: none;
    selection-background-color: #c7d2fe;
    selection-color: #1e293b;
    padding: 16px 18px;
    line-height: 150%;
}

/* ── bottom dock + tabs ───────────────────────────────────────────────── */
QDockWidget#bottomDock {
    titlebar-close-icon: url(none);
    titlebar-normal-icon: url(none);
}
QDockWidget#bottomDock::title {
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    padding: 10px 16px;
    font-weight: 600;
    color: #475569;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

QTabWidget#bottomTabs::pane {
    border-top: 1px solid #e2e8f0;
    background: #ffffff;
    top: -1px;
}
QTabWidget#bottomTabs QTabBar {
    background: #ffffff;
}
QTabWidget#bottomTabs QTabBar::tab {
    background: transparent;
    color: #64748b;
    padding: 12px 18px;
    border: none;
    margin-right: 2px;
    font-weight: 500;
    min-width: 100px;
}
QTabWidget#bottomTabs QTabBar::tab:selected {
    color: #0f172a;
    border-bottom: 2px solid #6366f1;
}
QTabWidget#bottomTabs QTabBar::tab:hover:!selected {
    color: #1e293b;
    background: #f8fafc;
}

/* ── suggestion panel ──────────────────────────────────────────────────── */
QFrame#suggestionCard {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

QLabel#suggestionIndex {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}
QLabel#suggestionIssueWarn {
    color: #d97706;
    background: #fffbeb;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
}

QFrame#legacyChip {
    background: #fef3c7;
    border-radius: 10px;
}
QFrame#pineChip {
    background: #e0e7ff;
    border-radius: 10px;
}
QLabel#chipCaption {
    color: #475569;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.7px;
    text-transform: uppercase;
}
QLabel#chipValue {
    color: #0f172a;
    font-family: "JetBrains Mono", "SF Mono", "Menlo", "Consolas", "Monaco", monospace;
    font-size: 13px;
    font-weight: 500;
    line-height: 160%;
}

QLabel#arrowGlyph {
    color: #94a3b8;
    font-size: 24px;
    font-weight: 300;
    min-width: 30px;
}

/* Primary button: keep a 1px transparent border so its total height
 * matches the secondary (which has a real 1px border) — same content
 * height + same padding + same border = same total. */
QPushButton#primaryButton {
    background: #6366f1;
    color: white;
    border: 1px solid #6366f1;
    border-radius: 8px;
    padding: 6px 22px;
    min-height: 24px;
    font-weight: 600;
    min-width: 90px;
}
QPushButton#primaryButton:hover { background: #4f46e5; border-color: #4f46e5; }
QPushButton#primaryButton:pressed { background: #4338ca; border-color: #4338ca; }
QPushButton#primaryButton:disabled { background: #c7d2fe; color: #ffffff; border-color: #c7d2fe; }

QPushButton#secondaryButton {
    background: #ffffff;
    color: #475569;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 6px 22px;
    min-height: 24px;
    font-weight: 600;
    min-width: 90px;
}
QPushButton#secondaryButton:hover {
    border-color: #cbd5e1;
    color: #1e293b;
    background: #f8fafc;
}
QPushButton#secondaryButton:pressed {
    background: #f1f5f9;
}

QLabel#statusAccepted {
    color: #047857;
    background: #ecfdf5;
    padding: 6px 12px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 12px;
}
QLabel#statusRejected {
    color: #b91c1c;
    background: #fef2f2;
    padding: 6px 12px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 12px;
}

QLabel#emptyState {
    color: #94a3b8;
    font-size: 14px;
    padding: 80px 40px;
    line-height: 160%;
}

/* ── busy spinner page ──────────────────────────────────────────── */
QWidget#busyPage {
    background: #ffffff;
}
QLabel#busyCaption {
    color: #64748b;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.3px;
}

/* ── issues panel ────────────────────────────────────────────────────── */
QFrame#issueRowError {
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 10px;
}
QFrame#issueRowWarn {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 10px;
}
QLabel#issueHeadError {
    color: #b91c1c;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.4px;
}
QLabel#issueHeadWarn {
    color: #b45309;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.4px;
}
QLabel#issueBody {
    color: #1e293b;
    font-size: 13px;
    line-height: 150%;
}
QLabel#issueTokenText {
    color: #475569;
    font-family: "JetBrains Mono", "SF Mono", "Menlo", "Consolas", "Monaco", monospace;
    font-size: 11px;
    background: rgba(15, 23, 42, 0.04);
    padding: 6px 9px;
    border-radius: 6px;
}

/* ── segments table ──────────────────────────────────────────────────── */
QTableWidget#segmentsTable {
    background: #ffffff;
    border: none;
    gridline-color: #f1f5f9;
    selection-background-color: #eef2ff;
    selection-color: #1e293b;
    alternate-background-color: #fafafa;
}
QTableWidget#segmentsTable::item {
    padding: 12px 10px;
    border: none;
}
QHeaderView::section {
    background: #f8fafc;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    padding: 12px 10px;
    font-weight: 600;
    color: #64748b;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

/* ── settings dialog ─────────────────────────────────────────────────── */
QDialog {
    background: #ffffff;
}
QLabel#settingsHeader {
    color: #0f172a;
    font-size: 18px;
    font-weight: 700;
}
QLabel#settingsSubheader {
    color: #64748b;
    font-size: 12px;
    line-height: 150%;
}

/* ── status bar ──────────────────────────────────────────────────────── */
QStatusBar {
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    color: #64748b;
    padding: 6px 14px;
}
QStatusBar QLabel {
    color: #475569;
}
QLabel#statsLabel {
    color: #64748b;
    font-family: "JetBrains Mono", "SF Mono", "Menlo", "Consolas", "Monaco", monospace;
    font-size: 11px;
}

/* ── dialogs / generic ──────────────────────────────────────────────── */
QMessageBox, QInputDialog, QFileDialog {
    background: #ffffff;
}
QPushButton {
    background: #ffffff;
    color: #1e293b;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 6px 18px;
    min-height: 24px;
    font-weight: 500;
}
QPushButton:hover {
    border-color: #cbd5e1;
    background: #f8fafc;
}
QPushButton:default {
    background: #6366f1;
    color: white;
    border: 1px solid #6366f1;
    font-weight: 600;
}
QPushButton:default:hover {
    background: #4f46e5;
    border-color: #4f46e5;
}

/* All interactive controls share a 38px total height so form rows
 * line up. Qt's QSS box model: total = padding + border + content;
 * "min-height" sets the *content* area. Vertical padding gives text
 * breathing room (descenders need it) while min-height guarantees
 * the widget is tall enough that the text isn't clipped at edges.
 *
 * 14px font + 6px+6px padding + 24px content + 1+1 border ≈ 38px.
 */
QLineEdit {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 6px 12px;
    min-height: 24px;
    selection-background-color: #c7d2fe;
    color: #0f172a;
}
QLineEdit:hover { border-color: #cbd5e1; }
QLineEdit:focus { border-color: #6366f1; }

QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 18px; height: 18px;
    border: 1.5px solid #cbd5e1;
    border-radius: 5px;
    background: #ffffff;
}
QCheckBox::indicator:checked {
    background: #6366f1;
    border-color: #6366f1;
}
QCheckBox::indicator:hover { border-color: #6366f1; }

/* ── scrollbars ───────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 5px;
    min-height: 36px;
}
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0; background: transparent;
}
QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px 4px;
}
QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 5px;
    min-width: 36px;
}
QScrollBar::handle:horizontal:hover { background: #94a3b8; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0; background: transparent;
}
