@page "/advanced-event-search"
@using System
@using System.Linq
@using System.Text.Json
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.Forms
@using AiInCourtAssistant.Shared.Models
@inject AiInCourtAssistant.Client.Services.AiRowClient Ai
@inject AiInCourtAssistant.Client.Services.PineLinks PineLinks

<h3>Advanced Event Search</h3>

<AdvancedEventSearchInput OnSearch="HandleSearch" />

<p>Total events loaded: @_searchResultList.Count</p>

@if (_isLoading)
{
    <p>Loading...</p>
}
else if (_searchResultList is null || !_searchResultList.Any())
{
    <p>No events found.</p>
}
else
{
    @if (_searchResultList.Any(ev => IsEditing(ev.EventID)))
    {
        <div class="alert alert-info my-2">
            ✏️ Editing: @_searchResultList.Where(ev => IsEditing(ev.EventID)).Select(ev => ev.CaseName).FirstOrDefault()
        </div>
    }

    @if (_listening)
    {
        <div class="alert alert-secondary py-1 px-2 my-2" role="status">
            🎧 Live (Enhanced) streaming… Tip: press <kbd>→</kbd> for Next Case
        </div>
    }

    <div class="d-flex justify-content-end mb-2">
        <button class="btn @(_listening ? "btn-danger" : "btn-success") me-2"
                @onclick="ToggleListen"
                @onclick:stopPropagation="true"
                data-live-control>
            @(_listening ? "■ Stop" : "🎙️ Listen")
        </button>

        <button class="btn btn-warning ms-2"
                title="Next case (→)"
                @onclick="ArmNextCase"
                @onclick:stopPropagation="true"
                disabled="@(!_listening || _armingNext)"
                data-live-control>
            ⏭ Next case (→)
        </button>

        <label class="btn btn-primary ms-2"
               for="sessionInput"
               title="Upload a full courtroom session recording for selected rows"
               @onclick:stopPropagation="true"
               data-live-control>
            ⬆️ Upload Session
        </label>

        @if (!string.IsNullOrWhiteSpace(_activeClientId))
        {
            <button class="btn btn-success ms-2"
                    title="Commit session previews (summaries, suggestions, transcripts)"
                    @onclick="SaveAllTranscriptsAsync"
                    @onclick:stopPropagation="true"
                    disabled="@(_listening || _savingAll)"
                    data-live-control>
                @(_savingAll ? "Saving…" : "✅ Save All (commit session)")
            </button>
        }

        <button class="btn btn-primary ms-2"
                @onclick="SaveAllTranscriptsAsync"
                @onclick:stopPropagation="true"
                disabled="@_listening"
                data-live-control>
            💾 Save All
        </button>

        @if (_uploadUiStep > 0)
        {
            <div class="alert alert-info d-flex align-items-center gap-3 my-2">
                <div class="spinner-border spinner-border-sm" role="status"></div>
                <div>
                    <b>@UploadTitle()</b>
                    <div class="progress mt-2" style="height:6px; max-width:360px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar"
                             style="width:@($"{UploadPct()}%")"></div>
                    </div>
                    @if (_lastUploadSessionId is not null)
                    {
                        <small class="text-muted">session @(_lastUploadSessionId.Value.ToString("N")[..8])</small>
                    }
                </div>
            </div>
        }

        <InputFile id="sessionInput" class="d-none" @ref="inputSessionFile" OnChange="OnSessionFileInput"
                   accept="audio/*,video/*" />
    </div>

    <!-- Bulk -->
    <div class="card p-3 mb-3">
        <h5>Bulk Update</h5>

        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select class="form-select" @bind="_bulkStatus">
                    <option value="">(No change)</option>
                    <option value="COMP">Completed</option>
                    <option value="CONT">Continued</option>
                    <option value="CANC">Cancelled</option>
                    <option value="FTA">FTA</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Notes</label>
                <input class="form-control" @bind="_bulkNotes" />
            </div>

            <div class="col-md-3">
                <button class="btn btn-primary w-100" @onclick="ApplyBulkUpdate" data-live-control>
                    Apply to Selected
                </button>
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-md-12">
                <label class="form-label">Notes for Court</label>
                <textarea class="form-control"
                          rows="2"
                          @bind="_bulkCourtNote"
                          @oninput="OnBulkCourtNoteInput"></textarea>
            </div>
        </div>
    </div>

    <!-- RESULTS -->
    <div class="adv-event mt-3">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th style="width:32px;"><input type="checkbox" @onchange="ToggleAll" /></th>
                    <th style="width:30%;">Case</th>
                    <th>Notes / Transcript</th>
                    <th style="width:1%; white-space:nowrap;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in _searchResultList)
                {
                    // ---- Parse "CASE – DEFENDANT" ----
                    var raw = ev.CaseName ?? string.Empty;
                    string casePart = raw, namePart = string.Empty;

                    var sep = " – ";
                    var idx = raw.IndexOf(sep, StringComparison.Ordinal);
                    if (idx < 0) { sep = " — "; idx = raw.IndexOf(sep, StringComparison.Ordinal); }
                    if (idx < 0) { sep = " - "; idx = raw.IndexOf(sep, StringComparison.Ordinal); }
                    if (idx >= 0)
                    {
                        casePart = raw[..idx].Trim();
                        namePart = raw[(idx + sep.Length)..].Trim();
                    }

                    string first = "", last = "";
                    if (!string.IsNullOrWhiteSpace(namePart))
                    {
                        if (namePart.Contains(","))
                        {
                            var segs = namePart.Split(',', 2, StringSplitOptions.TrimEntries);
                            last = segs[0];
                            var rhs = segs.Length > 1 ? segs[1] : "";
                            first = (rhs.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "");
                        }
                        else
                        {
                            var segs = namePart.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            if (segs.Length > 0) first = segs[0];
                            if (segs.Length > 1) last = segs[^1];
                        }
                    }

                    var defTokens = new[]
                    {
                        namePart, first, last,
                        string.IsNullOrWhiteSpace(first) || string.IsNullOrWhiteSpace(last) ? null : $"{first} {last}",
                        string.IsNullOrWhiteSpace(first) || string.IsNullOrWhiteSpace(last) ? null : $"{last} {first}"
                        }.Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().ToArray();

                    var caseTokens = new List<string> { casePart };
                    var digitsOnly = new string((casePart ?? "").Where(char.IsDigit).ToArray());
                    if (!string.IsNullOrWhiteSpace(digitsOnly))
                    {
                        caseTokens.Add(digitsOnly);
                        if (digitsOnly.Length >= 6) caseTokens.Add(digitsOnly[^6..]);
                        if (digitsOnly.Length >= 4) caseTokens.Add(digitsOnly[^4..]);
                    }

                    var expanded = IsRowExpanded(ev.EventID);
                    var liveRow = _activeEventId == ev.EventID;

                    <tr @key="ev.EventID"
                        id="row-@ev.EventID"
                        data-event-id="@ev.EventID"
                        data-def-names='@JsonSerializer.Serialize(defTokens)'
                        data-case-numbers='@JsonSerializer.Serialize(caseTokens)'>
                        <!-- select -->
                        <!-- select -->
                        <td class="align-top">
                            <input type="checkbox"
                                   checked="@ev.IsSelected"
                                   @onchange="@(_ =>
                                   {
                                     // flip the selection flag
                                       ev.IsSelected = !ev.IsSelected;

                                       // keep the legacy _selected set in sync for bulk update logic
                                       if (ev.IsSelected)
                                           _selected.Add(ev.EventID);
                                       else
                                           _selected.Remove(ev.EventID);

                                       StateHasChanged();
                                   })" />
                          </td>

                        <!-- LEFT: Case + meta (+ toggle) -->
                        <td class="align-top">
                            <span class="d-none" data-bind="def-name">@first</span>
                            <span class="d-none" data-bind="def-name">@last</span>
                            <span class="d-none" data-bind="case-number">@digitsOnly</span>

                            <div class="d-flex align-items-start justify-content-between">
                                <div class="case-name case-title">
                                    <a class="link-primary text-decoration-none"
                                       href="@PineLinks.CaseNotes(ev.CaseID)"
                                       target="_blank" rel="noopener noreferrer"
                                       title="Open in Pine (Notes)">
                                        <span data-bind="case-number">@casePart</span>
                                    </a>
                                    &nbsp;–&nbsp;
                                    <span data-bind="def-name">@namePart</span>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <button class="btn btn-link btn-sm p-0" @onclick="() => ToggleRow(ev.EventID)">
                                        @(expanded ? "▾ Hide details" : "▸ Show details")
                                    </button>
                                </div>
                            </div>

                            <div class="meta mt-2">
                                <div class="item">
                                    <span class="badge rounded-pill bg-secondary-subtle text-body-secondary">
                                        @EventTypePrettyLocal(ev.EventType)
                                    </span>
                                </div>
                                <div class="item">
                                    <span class="muted">Start:</span>
                                    <span class="fw-semibold">@GetStartDisplay(ev.EventID)</span>
                                </div>
                                <div class="item">
                                    <span class="muted me-1">Status:</span>
                                    @if (IsEditing(ev.EventID))
                                    {
                                        <select class="form-select form-select-sm d-inline-block" style="width:auto"
                                                @bind="_editStatusByEvent[ev.EventID]">
                                            <option value="">(Select)</option>
                                            <option value="CONT">Continued</option>
                                            <option value="COMP">Completed</option>
                                            <option value="CANC">Cancelled</option>
                                            <option value="FTA">FTA</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="status-badge">@GetStatusDisplay(ev.EventID)</span>
                                    }
                                </div>
                            </div>
                        </td>

                        <!-- RIGHT: NFC + Transcript (+ expanded details) -->
                        <td class="align-top">
                            <div class="mb-2">
                                <div class="section-title">Notes for Court</div>

                                <textarea class="form-control nfc-editor"
                                          rows="3"
                                          placeholder=""
                                          value="@GetNfcLive(ev.EventID)"
                                          @oninput="(e => OnNfcInput(ev, e))"
                                          @onblur="() => OnNfcBlur(ev)"
                                          spellcheck="true"
                                          id="notes-@ev.EventID"
                                          data-bind="notes"></textarea>

                                <div class="nfc-meta mt-1">
                                    @if (IsNfcSaving(ev.EventID))
                                    {
                                        <span class="saving">Saving…</span>
                                    }
                                    else if (GetNfcSavedAt(ev.EventID) is DateTime dt)
                                    {
                                        <span class="saved">Saved @dt.ToLocalTime().ToShortTimeString()</span>
                                    }
                                    @if (IsNfcError(ev.EventID))
                                    {
                                        <span class="error text-danger ms-2">Save failed — will retry</span>
                                    }
                                </div>
                            </div>

                            @if (liveRow || expanded)
                            {
                                <div class="d-flex align-items-center mb-1">
                                    <div class="section-title m-0">Transcript</div>
                                    <span class="badge bg-danger ms-2 d-none" data-live-badge>LIVE</span>
                                </div>

                                <textarea class="form-control"
                                          rows="6"
                                          placeholder="Transcript will appear here…"
                                          @oninput="(e => OnTranscriptInput(ev.EventID, e?.Value?.ToString() ?? string.Empty))"
                                          spellcheck="false"
                                          autocomplete="off"
                                          autocapitalize="off"
                                          id="transcript-@ev.EventID"
                                          data-bind="transcript"
                                          data-transcript
                                          @key="ev.EventID">@GetLiveTranscript(ev.EventID)</textarea>

                                @if (!string.IsNullOrWhiteSpace(GetTranscriptUrl(ev.EventID)))
                                {
                                    <div class="mt-1">
                                        <a class="link-primary" href="@GetTranscriptUrl(ev.EventID)" target="_blank">
                                            Open saved transcript
                                        </a>
                                    </div>
                                }

                                @* AI Summary: prefer session preview, fall back to live/client summary *@
                                @if (HasSummary(ev.EventID))
                                {
                                    <div class="ai-summary-card mt-3">
                                        <div class="ai-summary-header">
                                            AI Summary
                                        </div>
                                        <div class="ai-summary-body">
                                            @GetSummary(ev.EventID)
                                        </div>
                                    </div>
                                }
                                else if (AiHasSummary(ev.EventID))
                                {
                                    <div class="ai-summary-card mt-3">
                                        <div class="ai-summary-header">
                                            AI Summary
                                        </div>
                                        <div class="ai-summary-body">
                                            @AiGetSummary(ev.EventID)
                                        </div>
                                    </div>
                                }

                                @* AI Suggestions: one yellow bar per suggestion with Apply / Dismiss *@
                                @if (HasSuggestions(ev.EventID))
                                {
                                    var suggestions = GetSuggestions(ev.EventID);

                                    @foreach (var s in suggestions)
                                    {
                                        <div class="ai-suggestion-bar mt-2">
                                            <div class="ai-suggestion-main">
                                                <span>
                                                    <strong>Suggestion:</strong> @s.Title
                                                    @if (!string.IsNullOrWhiteSpace(s.Detail))
                                                    {
                                                        <span class="text-muted ms-1">— @s.Detail</span>
                                                    }
                                                </span>

                                                @if (s.Confidence.HasValue)
                                                {
                                                    <div class="ai-suggestion-confidence mt-1">
                                                        Confidence: @($"{s.Confidence:P0}")
                                                    </div>
                                                }
                                            </div>

                                            <div class="ai-suggestion-actions">
                                                <button class="btn btn-sm btn-primary"
                                                        @onclick="() => ApplySuggestionAsync(ev, s)">
                                                    Apply
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary ms-1"
                                                        @onclick="() => DismissPreviewSuggestion(ev.EventID, s)">
                                                    Dismiss
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }

                                <div class="mb-3 mt-3">
                                    <div class="section-title">Notes</div>

                                    @if (IsEditing(ev.EventID))
                                    {
                                        <textarea class="form-control" rows="3" placeholder="Enter notes…"
                                                  @bind="_editNotesByEvent[ev.EventID]" @bind:event="oninput"></textarea>
                                    }
                                    else
                                    {
                                        <textarea class="form-control" rows="3" readonly>@GetNotes(ev.EventID)</textarea>
                                    }
                                </div>
                            }
                        </td>

                        <!-- Actions -->
                        <td class="text-end align-top" style="white-space:nowrap;">
                            @if (IsEditing(ev.EventID))
                            {
                                <button class="btn btn-success btn-sm" @onclick="() => SaveInlineEdit(ev)">Save</button>
                                <button class="btn btn-secondary btn-sm ms-1" @onclick="() => CancelInlineEdit(ev)">Cancel</button>
                            }
                            else
                            {
                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="@(() => { BeginInlineEdit(ev); ExpandRow(ev.EventID); })">
                                    Edit
                                </button>
                            }

                            @if (!string.IsNullOrWhiteSpace(GetTranscriptUrl(ev.EventID)))
                            {
                                <button class="btn btn-outline-info btn-sm ms-1" @onclick="() => OpenTranscript(ev)">📄</button>
                            }

                            @if (!string.IsNullOrWhiteSpace(GetAudioUrl(ev.EventID)))
                            {
                                <button class="btn btn-outline-secondary btn-sm ms-1" @onclick="() => PlayAudio(ev)">▶️</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_nowPlayingUrl))
    {
        <div class="mt-3">
            <audio src="@_nowPlayingUrl" controls autoplay style="width:100%"></audio>
        </div>
    }
}

@code {
    // ===== AI caches & helpers for per-row summaries (client-side) =====
    private readonly Dictionary<int, string> _aiSummaryByEvent = new();
    private readonly Dictionary<int, DateTime> _aiLastRun = new();

    private const int MinCharsForAi = 200;
    private static readonly TimeSpan AiDebounce = TimeSpan.FromSeconds(12);
    private static readonly TimeSpan AiRerunGap = TimeSpan.FromSeconds(45);

    private bool AiHasSummary(int id) =>
        _aiSummaryByEvent.TryGetValue(id, out var s) && !string.IsNullOrWhiteSpace(s);

    private string AiGetSummary(int id) =>
        _aiSummaryByEvent.TryGetValue(id, out var s) ? s : string.Empty;

    private async Task RunAiForEventAsync(int eventId, bool force = false, CancellationToken ct = default)
    {
        var ev = _searchResultList?.FirstOrDefault(x => x.EventID == eventId);
        if (ev is null) return;

        var transcript = GetLiveTranscript(eventId) ?? string.Empty;
        if (!force && transcript.Length < MinCharsForAi) return;

        if (!force && _aiLastRun.TryGetValue(eventId, out var last) && DateTime.UtcNow - last < AiRerunGap)
            return;

        _aiLastRun[eventId] = DateTime.UtcNow;

        var raw = ev.CaseName ?? "";
        string caseNumber = raw.Split('—', '–', '-').FirstOrDefault()?.Trim() ?? "";
        string defendant = raw.Split('—', '–', '-').Skip(1).FirstOrDefault()?.Trim() ?? "";

        var res = await Ai.SummarizeAsync(eventId, transcript, caseNumber, defendant, ct);
        if (res is null) return;

        _aiSummaryByEvent[eventId] = res.Summary ?? string.Empty;
        StateHasChanged();
    }

    private CancellationTokenSource? _aiDebounceCts;
    private void DebounceAi(int eventId)
    {
        try { _aiDebounceCts?.Cancel(); } catch { }
        _aiDebounceCts = new CancellationTokenSource();
        var token = _aiDebounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(AiDebounce, token);
                await InvokeAsync(async () => await RunAiForEventAsync(eventId, false, token));
            }
            catch (TaskCanceledException) { }
        }, token);
    }

    private void OnTranscriptInput(int eventId, string text)
    {
        SetLiveTranscript(eventId, text);
        DebounceAi(eventId);
    }
}
