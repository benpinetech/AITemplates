@using AiInCourtAssistant.Shared.Models
@using AiInCourtAssistant.Client.Services
@using Microsoft.AspNetCore.Components

<div class="mb-3">
    <label class="form-label">Start Date</label>
    <InputDate @bind-Value="_startDateFromInput" class="form-control" />
</div>

<div class="mb-3">
    <label class="form-label">Location</label>
    <select class="form-select" @bind="_selectedLocation">
        <option value="">-- Select Location --</option>
        @foreach (var pair in _locationOptions)
        {
            <option value="@pair.Value">@pair.Key</option>
        }
    </select>
</div>

<button class="btn btn-primary" @onclick="RunSearch">Search</button>

@code {
    [Parameter] public EventCallback<AdvancedEventSearchFE> OnSearch { get; set; }

    private DateTime? _startDateFromInput;
    private string _selectedLocation;

    private Dictionary<string, string> _locationOptions = new()
    {
        { "Courtroom A", "CRTA" },
        { "Courtroom B", "CRTB" },
        { "Courtroom C", "CRTC" }
    };

    private AdvancedEventSearchFE _searchModel = new();

    private async Task RunSearch()
    {
        if (_startDateFromInput.HasValue)
        {
            var d = _startDateFromInput.Value.Date;
            _searchModel.EventStartDateFrom = d;
            _searchModel.EventStartDateTo = d.AddDays(1);
        }
        else
        {
            _searchModel.EventStartDateFrom = null;
            _searchModel.EventStartDateTo = null;
        }

        _searchModel.EventLocation = string.IsNullOrWhiteSpace(_selectedLocation)
            ? null
            : new[] { _selectedLocation };

        await OnSearch.InvokeAsync(_searchModel);
    }
}
