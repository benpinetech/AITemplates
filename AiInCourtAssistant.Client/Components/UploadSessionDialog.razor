@inject AiInCourtAssistant.Client.Services.SessionTranscribeClient Api

@if (Visible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal show d-block" tabindex="-1" style="z-index:1060">
        <div class="modal-dialog modal-md">
            <div class="modal-content p-3">
                <h5 class="mb-3">Upload Court Session</h5>
                <p class="text-muted mb-2">Select the full courtroom recording for @Courtroom (@DocketDate:ddd, MMM d).</p>
                <InputFile OnChange="OnFile" accept="audio/*,video/*" />
                @if (!string.IsNullOrWhiteSpace(Status))
                {
                    <div class="mt-3 small">@Status</div>
                }
                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-secondary" @onclick="() => Close()">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<Guid> OnUploaded { get; set; }

    public bool Visible { get; private set; }
    public Guid TenantId { get; private set; }
    public string Courtroom { get; private set; } = "";
    public DateOnly DocketDate { get; private set; }

    private string? Status;

    public void Show(Guid tenantId, string courtroom, DateOnly docketDate)
    {
        TenantId = tenantId; Courtroom = courtroom; DocketDate = docketDate;
        Status = null;
        Visible = true;
        StateHasChanged();
    }

    private async Task OnFile(InputFileChangeEventArgs e)
    {
        try
        {
            Status = "Uploading…";
            var file = e.File;
            var sessionId = await Api.UploadAsync(TenantId, Courtroom, DocketDate, file);
            Status = "Processing… you can close this dialog.";
            await OnUploaded.InvokeAsync(sessionId);
        }
        catch (Exception ex)
        {
            Status = $"Error: {ex.Message}";
        }
    }

    public void Close()
    {
        Visible = false;
        Status = null;
        StateHasChanged();
    }
}
